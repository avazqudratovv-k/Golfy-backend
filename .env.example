# --- required ---
# MongoDB connection string (Atlas or local, e.g. mongodb://127.0.0.1:27017/golfy)
MONGO_URL=
# secret used to sign login tokens; use a long random string
SECRET_TOKEN=

# --- optional ---
# user API port (default 3011)
PORT=3011
# admin API port (default 3012)
ADMIN_PORT=3012
# comma separated list of allowed browser origins; unset = any origin is allowed
# e.g. CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ORIGINS=
# when set, POST /signup on the admin API requires this value in the "x-admin-secret" header
# (or an "adminSecret" body field). Leave empty only on a local machine.
ADMIN_SIGNUP_SECRET=
# password given to the demo admins created by `npm run seed` (default Admin123!)
SEED_ADMIN_PASSWORD=
