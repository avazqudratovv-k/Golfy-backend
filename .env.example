# --- required ---
# MongoDB connection string (Atlas or local, e.g. mongodb://127.0.0.1:27017/golfy)
MONGO_URL=mongodb://127.0.0.1:27017/golfy
# secret used to sign login tokens; use a long random string (e.g. `openssl rand -hex 32`)
SECRET_TOKEN=change-me-to-a-long-random-string

# --- optional ---
# user API port (default 3011)
PORT=3011
# admin API port (default 3012)
ADMIN_PORT=3012
# "production" turns on Secure cookies by default and removes the local-dev CORS defaults
NODE_ENV=development

# CORS: comma separated list of browser origins that may call the API with credentials.
# Unset = the local dev apps (localhost/127.0.0.1 on ports 3000 and 3001) outside production, nothing in production.
# Any other origin gets no CORS headers at all.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Auth cookies are always httpOnly.
# SameSite: lax (default), strict or none (none forces Secure). Secure: true/false; default false in dev, true when NODE_ENV=production.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Set when the API runs behind a reverse proxy so the rate limiter sees the real client IP:
# "true", a hop count such as "1", or an Express value such as "loopback". Unset = do not trust proxies.
TRUST_PROXY=

# When set, POST /signup on the admin API must present this value (header "x-admin-secret" or body field "adminSecret").
# The admin app reads GET /signup-info to mark the field as required. Leave empty only on a local machine.
ADMIN_SIGNUP_SECRET=
# password given to the demo admins created by `npm run seed` (default Admin123!)
SEED_ADMIN_PASSWORD=
