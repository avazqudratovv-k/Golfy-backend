# Copy to .env.production on the server (git- and docker-ignored) and fill in the values.
# Never commit the real file.
NODE_ENV=production
# Atlas connection string (allow the VPS IP in Atlas Network Access)
MONGO_URL=
# long random string: openssl rand -hex 32
SECRET_TOKEN=
# required to create admin accounts on the admin API: openssl rand -hex 16
ADMIN_SIGNUP_SECRET=
# container ports (compose publishes them on 127.0.0.1:4200 and 127.0.0.1:4201)
PORT=3011
ADMIN_PORT=3012
CORS_ORIGINS=https://golfy.76-13-198-17.sslip.io,https://golfy-admin.76-13-198-17.sslip.io
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# one reverse proxy (host nginx) in front
TRUST_PROXY=1
# optional: password for the demo admins created by the seed (default Admin123!), change it in production
SEED_ADMIN_PASSWORD=
